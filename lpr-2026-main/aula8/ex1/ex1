using System;

struct Filme
{
    public string titulo;
    public string diretor;
    public int ano;
    public int duracao;
}

class Program
{
    static void Main()
    {
        Filme[] filmes = new Filme[3];

        for (int i = 0; i < 3; i++)
        {
            Console.WriteLine("Filme " + (i + 1));

            Console.Write("Título: ");
            filmes[i].titulo = Console.ReadLine();

            Console.Write("Diretor: ");
            filmes[i].diretor = Console.ReadLine();

            Console.Write("Ano: ");
            filmes[i].ano = int.Parse(Console.ReadLine());

            Console.Write("Duração: ");
            filmes[i].duracao = int.Parse(Console.ReadLine());
        }

        Console.WriteLine("\nFilmes cadastrados:");

        for (int i = 0; i < 3; i++)
        {
            Console.WriteLine(filmes[i].titulo + " - " + filmes[i].ano);
        }

        int menor = 0;

        for (int i = 1; i < 3; i++)
        {
            if (filmes[i].ano < filmes[menor].ano)
            {
                menor = i;
            }
        }

        Console.WriteLine("\nFilme mais antigo:");
        Console.WriteLine(filmes[menor].titulo);
    }
}